# ---- Database -------------------------------------------------------------
# SQLite file. In Docker this points at the mounted volume (/data/app.db).
DATABASE_URL="file:./prisma/dev.db"

# ---- Branding -------------------------------------------------------------
# The organisation shown in the header and on the sign-in card. Read at
# runtime, so one published image serves any organisation.
ORG_NAME="Acme"

# Optional sub-brand: the club, committee or group that actually runs the
# campaigns. Set it and the masthead becomes two lines — this name in large
# type, the organisation beneath it — and the app's own name steps aside to the
# browser tab. Leave it empty for just the organisation.
# BRAND_NAME="Fedtnessklubben"

# ---- Application ----------------------------------------------------------
# Signs session cookies. Must be at least 16 characters; required in production.
# Generate one with: openssl rand -base64 32
APP_SECRET=""

# Timezone that decides when "today" rolls over for entry logging.
APP_TIMEZONE="Europe/Copenhagen"

# Pins the app's idea of today (YYYY-MM-DD). Useful for demos against the
# seeded data and for tests. Leave unset in production to use the real date.
# APP_TODAY="2026-08-12"

# Public origin of the deployment, e.g. https://dysten.example.com. Used to
# build the OAuth redirect URI, which must match the app registration exactly,
# and every redirect the auth routes send the browser to. Behind a reverse
# proxy the request's own origin is whatever the proxy forwarded — often the
# internal 0.0.0.0:3000 the server bound to, which no browser can follow. Set
# this and the guesswork goes away.
# APP_URL=""

# ---- Authentication -------------------------------------------------------
# "dev" uses the account-picker sign-in; "entra" selects Microsoft 365.
AUTH_PROVIDER="dev"

# Allows the development sign-in to run with NODE_ENV=production. Only ever set
# this for a throwaway demo deployment.
# ALLOW_DEV_AUTH="false"

# Anyone signing in with one of these addresses is provisioned as an admin.
# The very first user to sign in becomes an admin regardless.
SEED_ADMIN_EMAILS=""

# Required when AUTH_PROVIDER=entra. See src/lib/auth/entra-provider.ts.
#
# Comma-separated allowlist of tenant ids permitted to sign in. Normally one.
#
# With ONE id, three independent layers hold: register the app as single-tenant
# so Microsoft itself refuses everyone else, the authority names that tenant
# (never /common), and the token's tid claim is checked in code.
#
# With MORE THAN ONE, the first two are gone — no authority URL names a subset
# of tenants, so the registration has to be multi-tenant and the authority
# becomes /organizations. This list then becomes the only thing between the app
# and every Microsoft tenant on earth. Add a second id deliberately, not idly.
# ENTRA_TENANT_IDS=""
# ENTRA_CLIENT_ID=""
# ENTRA_CLIENT_SECRET=""

# Guest (B2B) accounts invited into your directory carry your tenant id but
# belong to another organisation. Set false to keep them out.
# ENTRA_ALLOW_GUESTS="true"

# ---- Notifications --------------------------------------------------------
# Setting either of these enables that channel. Both transports are stubs today
# and will throw until implemented — see src/lib/notifications/index.ts.
# SMTP_URL=""
# TEAMS_WEBHOOK_URL=""

# Shared secret guarding POST /api/notifications/run, so a scheduler can
# trigger reminder delivery. Leave unset to disable the endpoint entirely.
# NOTIFICATIONS_RUN_TOKEN=""
